{
  "version": 1,
  "author": "IoT Learning Hub - Chapter 06",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 120, "left": -120, "attrs": { "color": "blue", "bounce": "1" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 130, "left": 180, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": 110, "left": 250, "attrs": { "color": "green" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:27", "btn1:1.r", "blue", [ "h0" ] ],
    [ "btn1:2.r", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:25", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "led1:A", "green", [ "h0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}

