{
  "version": 1,
  "author": "IoT Learning Hub - Chapter 05",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": 130, "left": 180, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_status", "top": 110, "left": 250, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 190, "left": 180, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_alert", "top": 170, "left": 250, "attrs": { "color": "red" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:25", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "led_status:A", "green", [ "h0" ] ],
    [ "led_status:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:26", "r2:1", "red", [ "h0" ] ],
    [ "r2:2", "led_alert:A", "red", [ "h0" ] ],
    [ "led_alert:C", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}

