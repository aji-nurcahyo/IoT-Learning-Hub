[
  {
    "id": "tab_telemetry_flow",
    "type": "tab",
    "label": "IoT Environmental Pipeline",
    "disabled": false,
    "info": "Pipeline integrasi event-driven Node-RED untuk telemetri lingkungan dan sistem peringatan dini."
  },
  {
    "id": "node_mqtt_in",
    "type": "mqtt in",
    "z": "tab_telemetry_flow",
    "name": "MQTT Telemetry In",
    "topic": "iot/lab/+/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_local",
    "nl": false,
    "rap": false,
    "x": 140,
    "y": 120,
    "wires": [["node_switch_filter", "node_save_context"]]
  },
  {
    "id": "node_save_context",
    "type": "change",
    "z": "tab_telemetry_flow",
    "name": "Update Global Twin",
    "rules": [
      {
        "t": "set",
        "p": "latest_telemetry",
        "pt": "global",
        "to": "payload",
        "tot": "msg"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 380,
    "y": 80,
    "wires": [[]]
  },
  {
    "id": "node_switch_filter",
    "type": "switch",
    "z": "tab_telemetry_flow",
    "name": "Check Temp Threshold",
    "property": "payload.metrics.temp_c",
    "propertyType": "msg",
    "rules": [
      { "t": "gte", "v": "30.0", "vt": "num" },
      { "t": "lt", "v": "30.0", "vt": "num" }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 390,
    "y": 140,
    "wires": [["node_alarm_enricher"], ["node_normal_log"]]
  },
  {
    "id": "node_alarm_enricher",
    "type": "function",
    "z": "tab_telemetry_flow",
    "name": "Format Alarm Event",
    "func": "const temp = msg.payload.metrics.temp_c;\nconst dev = msg.payload.dev;\nmsg.payload = {\n  event_id: 'ALM-' + Date.now(),\n  dev: dev,\n  type: 'HIGH_TEMPERATURE',\n  severity: 'warning',\n  measured_temp: temp,\n  threshold: 30.0,\n  ts: Math.floor(Date.now() / 1000)\n};\nmsg.topic = 'iot/lab/' + dev + '/event/alarm';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 640,
    "y": 120,
    "wires": [["node_mqtt_out_alarm"]]
  },
  {
    "id": "node_normal_log",
    "type": "debug",
    "z": "tab_telemetry_flow",
    "name": "Normal Log",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 610,
    "y": 180,
    "wires": []
  },
  {
    "id": "node_mqtt_out_alarm",
    "type": "mqtt out",
    "z": "tab_telemetry_flow",
    "name": "MQTT Alert Publish",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "broker_local",
    "x": 860,
    "y": 120,
    "wires": []
  },
  {
    "id": "node_http_in",
    "type": "http in",
    "z": "tab_telemetry_flow",
    "name": "GET /api/v1/telemetry/latest",
    "url": "/api/v1/telemetry/latest",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 170,
    "y": 260,
    "wires": [["node_http_handler"]]
  },
  {
    "id": "node_http_handler",
    "type": "function",
    "z": "tab_telemetry_flow",
    "name": "Serve Latest State",
    "func": "const state = global.get('latest_telemetry') || { status: 'NO_DATA' };\nmsg.payload = state;\nmsg.statusCode = 200;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 260,
    "wires": [["node_http_response"]]
  },
  {
    "id": "node_http_response",
    "type": "http response",
    "z": "tab_telemetry_flow",
    "name": "HTTP 200 Response",
    "statusCode": "200",
    "headers": { "content-type": "application/json" },
    "x": 670,
    "y": 260,
    "wires": []
  },
  {
    "id": "node_catch_error",
    "type": "catch",
    "z": "tab_telemetry_flow",
    "name": "Catch Runtime Exceptions",
    "scope": null,
    "uncaught": false,
    "x": 160,
    "y": 340,
    "wires": [["node_dead_letter"]]
  },
  {
    "id": "node_dead_letter",
    "type": "debug",
    "z": "tab_telemetry_flow",
    "name": "Dead Letter Log",
    "active": true,
    "tosidebar": true,
    "console": true,
    "tostatus": false,
    "complete": "error",
    "targetType": "msg",
    "x": 410,
    "y": 340,
    "wires": []
  }
]
