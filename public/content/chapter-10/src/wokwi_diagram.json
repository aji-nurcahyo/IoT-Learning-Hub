{
  "version": 1,
  "author": "IoT Learning Hub - Chapter 10 Capstone",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ntc-temperature-sensor", "id": "ntc1", "top": 60, "left": -160, "attrs": { "temperature": "26" } },
    { "type": "wokwi-pushbutton", "id": "btn_mode", "top": 170, "left": -130, "attrs": { "color": "blue", "bounce": "1" } },
    { "type": "wokwi-slide-switch", "id": "sw_interlock", "top": 240, "left": -130, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r_fan", "top": 90, "left": 180, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_fan", "top": 70, "left": 250, "attrs": { "color": "cyan" } },
    { "type": "wokwi-resistor", "id": "r_stat", "top": 150, "left": 180, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_status", "top": 130, "left": 250, "attrs": { "color": "green" } },
    { "type": "wokwi-buzzer", "id": "bz_alarm", "top": 200, "left": 210, "attrs": { "volume": "0.5" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ntc1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ntc1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "ntc1:OUT", "esp:34", "orange", [ "h0" ] ],
    [ "esp:27", "btn_mode:1.r", "blue", [ "h0" ] ],
    [ "btn_mode:2.r", "esp:GND.1", "black", [ "v0" ] ],
    [ "sw_interlock:2", "esp:14", "purple", [ "h0" ] ],
    [ "sw_interlock:1", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:25", "r_fan:1", "cyan", [ "h0" ] ],
    [ "r_fan:2", "led_fan:A", "cyan", [ "h0" ] ],
    [ "led_fan:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:26", "r_stat:1", "green", [ "h0" ] ],
    [ "r_stat:2", "led_status:A", "green", [ "h0" ] ],
    [ "led_status:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:18", "bz_alarm:2", "red", [ "h0" ] ],
    [ "bz_alarm:1", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}

