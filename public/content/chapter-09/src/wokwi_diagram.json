{
  "version": 1,
  "author": "IoT Learning Hub - Chapter 09",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_temp", "top": 100, "left": -140, "attrs": {} },
    { "type": "wokwi-slide-switch", "id": "sw_interlock", "top": 210, "left": -130, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r_fan", "top": 120, "left": 180, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_fan", "top": 100, "left": 250, "attrs": { "color": "cyan" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 180, "left": 210, "attrs": { "volume": "0.5" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pot_temp:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot_temp:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot_temp:SIG", "esp:34", "orange", [ "h0" ] ],
    [ "sw_interlock:2", "esp:27", "blue", [ "h0" ] ],
    [ "sw_interlock:1", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:25", "r_fan:1", "green", [ "h0" ] ],
    [ "r_fan:2", "led_fan:A", "green", [ "h0" ] ],
    [ "led_fan:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:26", "bz1:2", "red", [ "h0" ] ],
    [ "bz1:1", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}

