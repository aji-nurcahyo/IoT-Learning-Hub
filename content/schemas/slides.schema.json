{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 3
      },
      "body": {
        "type": "string",
        "minLength": 5
      },
      "notes": {
        "type": "string",
        "minLength": 10
      },
      "fragment": {
        "type": "string"
      }
    },
    "required": [
      "title",
      "body",
      "notes"
    ],
    "additionalProperties": false
  }
}
